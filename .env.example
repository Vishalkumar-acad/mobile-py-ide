# ---- Mobile Py IDE configuration ----
# Copy to .env and edit. All values are optional; defaults are shown.

# --- HTTP ---
HOST=127.0.0.1
PORT=3000

# --- Execution limits ---
TIMEOUT_MS=5000
MEMORY_LIMIT_MB=128
MAX_CODE_BYTES=102400
MAX_STDIN_BYTES=20480
MAX_OUTPUT_BYTES=102400
PYTHON_BIN=python3

# Interactive runs: stop after this much inactivity, and at the hard cap.
RUN_IDLE_MS=30000
RUN_MAX_MS=120000
# Keep a finished run around this long so a late output stream still gets it.
RUN_RETAIN_MS=60000
# REPL / terminal sessions stay open longer.
REPL_IDLE_MS=300000
REPL_MAX_MS=1800000

# Install allow-listed packages from the IDE (heavy libraries are never allowed).
ALLOW_PACKAGE_INSTALL=true
# EXTRA_PACKAGES=rich,tabulate

# A real shell on the server. OFF by default; enable only behind Cloudflare Access.
ALLOW_TERMINAL=false
TERMINAL_MEMORY_MB=512

# --- Workspace (where programs keep files) ---
# Defaults to <app dir>/workspace. Point this at a bigger disk if you have one.
# WORKSPACE_DIR=/opt/mobile-py-ide/workspace
ALLOW_FILE_ACCESS=true
MAX_FILE_MB=256
WORKSPACE_MAX_MB=10240
MAX_UPLOAD_MB=256

# --- Anonymous per-visitor spaces ---
# Each browser gets its own folder; idle spaces are deleted after this long.
SPACE_TTL_MS=86400000
PER_USER_MAX_MB=512
# SWEEP_INTERVAL_MS=600000
# Pin the cookie-signing secret (otherwise one is generated and kept on disk).
# COOKIE_SECRET=

# --- Sandbox hardening ---
# Block outbound network from the runner. Needs root or user-namespaces.
DISABLE_NETWORK=false
# Run the runner as a low-privilege user (only if the server runs as root).
# RUN_AS_UID=1001
# RUN_AS_GID=1001

# --- Rate limiting (per client IP) ---
RATE_WINDOW_MS=60000
RATE_MAX=60

# --- Concurrency guard (memory safety on small servers) ---
MAX_CONCURRENT_RUNS=2
MAX_QUEUE=8

# --- Validation policy ---
# STRICT_MODE=true -> only the built-in allow-list of modules may be imported.
STRICT_MODE=false
# Comma-separated extras.
# EXTRA_BLOCKED_MODULES=
# EXTRA_ALLOWED_MODULES=
# Remove a name from the built-in blocked list (e.g. after installing it yourself).
# UNBLOCK_MODULES=pandas
